# Get these from Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Absolute site URL, used for metadata/OG tags/sitemap/robots.
# Update to the real production URL once deployed (Phase 6).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — Supabase project settings → API → "service_role" secret.
# Powers hospital/provider invite emails (auth.admin.inviteUserByEmail).
# NEVER prefix this with NEXT_PUBLIC_ or reference it from a "use client"
# file — it bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Cloud Console → Credentials. Only needs "Maps Embed API" enabled
# and restricted (HTTP referrer + API restrictions). Powers the patient
# "Nearby Services" page.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Resend (Vercel Marketplace) — powers the Discovery Call notification
# email (lib/email/discovery-call.ts). Server-only.
RESEND_API_KEY=your-resend-api-key

# Optional — defaults to Resend's sandbox sender if unset. Requires a
# verified sending domain in Resend for real (non-sandbox) delivery.
DISCOVERY_CALL_FROM_EMAIL=MELLOW Consortium <onboarding@resend.dev>